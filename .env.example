# Benchmark model configuration (the key itself stays in .env or the host environment)
BENCHMARK_MODEL_PROVIDER=nvidia
BENCHMARK_MODEL=nvidia/nemotron-3-super-120b-a12b
# Other NVIDIA API models:
# BENCHMARK_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# BENCHMARK_MODEL=meta/llama-3.3-70b-instruct
# BENCHMARK_MODEL=deepseek-ai/deepseek-r1
# BENCHMARK_MODEL=qwen/qwen2.5-72b-instruct
BENCHMARK_API_KEY_ENV=NVIDIA_API_KEY
NVIDIA_API_KEY=

# Optional OpenAI-compatible provider settings
# BENCHMARK_MODEL_PROVIDER=openai
# BENCHMARK_MODEL=gpt-5-mini
# BENCHMARK_API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=
